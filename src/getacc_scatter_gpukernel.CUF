      CALL syncthreads()
    END DO
    i1 = i1 + blockDim%x
  END DO

  i1 = threadIdx%x - 1
  DO WHILE (i1 < ind_maps6size * (1) )
    moduloResult = mod(i1,1)
    opDat6Devicegetacc_scatter(moduloResult + ind_maps6 &
    & (ind_maps6offset + i1 / (1)) * (1) + 1) = &
    & opDat6Devicegetacc_scatter(moduloResult + ind_maps6 &
    & (ind_maps6offset + i1 / (1)) * (1) + 1) + &
    & sharedFloat8(opDat6nBytes + i1)
    i1 = i1 + blockDim%x
  END DO
  i1 = threadIdx%x - 1
  DO WHILE (i1 < ind_maps10size * (1) )
    moduloResult = mod(i1,1)
    opDat10Devicegetacc_scatter(moduloResult + ind_maps10 &
    & (ind_maps10offset + i1 / (1)) * (1) + 1) = &
    & opDat10Devicegetacc_scatter(moduloResult + ind_maps10 &
    & (ind_maps10offset + i1 / (1)) * (1) + 1) + &
    & sharedFloat8(opDat10nBytes + i1)
    i1 = i1 + blockDim%x
  END DO
  i1 = threadIdx%x - 1
  DO WHILE (i1 < ind_maps14size * (1) )
    moduloResult = mod(i1,1)
    opDat14Devicegetacc_scatter(moduloResult + ind_maps14 &
    & (ind_maps14offset + i1 / (1)) * (1) + 1) = &
    & opDat14Devicegetacc_scatter(moduloResult + ind_maps14 &
    & (ind_maps14offset + i1 / (1)) * (1) + 1) + &
    & sharedFloat8(opDat14nBytes + i1)
    i1 = i1 + blockDim%x
  END DO
  i1 = threadIdx%x - 1
  DO WHILE (i1 < ind_maps18size * (1) )
    moduloResult = mod(i1,1)
    opDat18Devicegetacc_scatter(moduloResult + ind_maps18 &
    & (ind_maps18offset + i1 / (1)) * (1) + 1) = &
    & opDat18Devicegetacc_scatter(moduloResult + ind_maps18 &
    & (ind_maps18offset + i1 / (1)) * (1) + 1) + &
    & sharedFloat8(opDat18nBytes + i1)
    i1 = i1 + blockDim%x
  END DO


END SUBROUTINE

