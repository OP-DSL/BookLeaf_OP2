      opDat22Host = opDat22Host + reductionArrayHost22(i10+1)
    END DO

    deallocate( reductionArrayHost22 )
    CALL op_mpi_reduce_double(opArg22,opArg22%data)

    reductionArrayHost23 = reductionArrayDevice23write_regvalues

