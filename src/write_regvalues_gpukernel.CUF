    & 0.d0, 0.00000,0.00000, 0)
    call op_timers_core(startTime)

    n_upper = op_mpi_halo_exchanges_cuda(set%setCPtr,numberOfOpDats,opArgArray)

    indirectionDescriptorArray(1) = -1
    indirectionDescriptorArray(2) = -1
