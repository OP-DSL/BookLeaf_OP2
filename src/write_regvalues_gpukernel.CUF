      & opDat27Host, &
      & pblkMap, &
      & poffset,pnelems,pnthrcol,pthrcol, &
      & set%setPtr%size+set%setPtr%exec_size, blockOffset)

      blockOffset = blockOffset + blocksPerGrid
    END DO


    IF ((n_upper .EQ. 0) .OR. (n_upper .EQ. set%setPtr%core_size)) THEN
      CALL op_mpi_wait_all_cuda(numberOfOpDats,opArgArray)
    END IF


    CALL op_mpi_set_dirtybit_cuda(numberOfOpDats,opArgArray)

    reductionArrayHost16 = reductionArrayDevice16write_regvalues

    DO i10 = 0, reductionCardinality16 - 1, 1
      opDat16Host = opDat16Host + reductionArrayHost16(i10+1)
    END DO

    deallocate( reductionArrayHost16 )
    CALL op_mpi_reduce_double(opArg16,opArg16%data)

    reductionArrayHost17 = reductionArrayDevice17write_regvalues

    DO i10 = 0, reductionCardinality17 - 1, 1
      opDat17Host = opDat17Host + reductionArrayHost17(i10+1)
    END DO

