    CALL c_f_pointer(opArg28%data_d,opDat28Devicewrite_regvalues,(/opDat28Cardinality/))

    CALL c_f_pointer(planRet_write_regvalues,actualPlan_write_regvalues)
    CALL c_f_pointer(actualPlan_write_regvalues%ncolblk,ncolblk,(/set%setPtr%size/))
    pblkMapSize = actualPlan_write_regvalues%nblocks
    CALL c_f_pointer(actualPlan_write_regvalues%blkmap_d,pblkMap,(/pblkMapSize/))
    poffsetSize = actualPlan_write_regvalues%nblocks
    CALL c_f_pointer(actualPlan_write_regvalues%offset_d,poffset,(/poffsetSize/))
    pnelemsSize = actualPlan_write_regvalues%nblocks
    CALL c_f_pointer(actualPlan_write_regvalues%nelems_d,pnelems,(/pnelemsSize/))
    pnthrcolSize = actualPlan_write_regvalues%nblocks
