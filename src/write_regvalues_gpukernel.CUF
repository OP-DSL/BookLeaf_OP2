    DO i10 = 0, reductionCardinality24 - 1, 1
      opDat24Host = MIN(opDat24Host , reductionArrayHost24(i10+1))
    END DO

    deallocate( reductionArrayHost24 )
    CALL op_mpi_reduce_double(opArg24,opArg24%data)

    reductionArrayHost25 = reductionArrayDevice25write_regvalues

    DO i10 = 0, reductionCardinality25 - 1, 1
      opDat25Host = opDat25Host + reductionArrayHost25(i10+1)
    END DO

    deallocate( reductionArrayHost25 )
    CALL op_mpi_reduce_double(opArg25,opArg25%data)

    reductionArrayHost26 = reductionArrayDevice26write_regvalues

    DO i10 = 0, reductionCardinality26 - 1, 1
      opDat26Host = opDat26Host + reductionArrayHost26(i10+1)
    END DO

    deallocate( reductionArrayHost26 )
    CALL op_mpi_reduce_double(opArg26,opArg26%data)

    istat = cudaDeviceSynchronize()
    call op_timers_core(endTime)

    returnSetKernelTiming = setKernelTime(28 , userSubroutine//C_NULL_CHAR, &
    & endTime-startTime, actualPlan_write_regvalues%transfer,actualPlan_write_regvalues%transfer2, 1)
    calledTimes = calledTimes + 1
  END SUBROUTINE

  END MODULE
