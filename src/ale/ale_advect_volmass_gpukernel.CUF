  opDat12Cardinality = opArg12%dim * getSetSizeFromOpArg(opArg12)
  opDat13Cardinality = opArg13%dim * getSetSizeFromOpArg(opArg13)
  opDat14Cardinality = opArg14%dim * getSetSizeFromOpArg(opArg14)
  opDat15Cardinality = opArg15%dim * getSetSizeFromOpArg(opArg15)
  opDat16Cardinality = opArg16%dim * getSetSizeFromOpArg(opArg16)
  opDat17Cardinality = opArg17%dim


  CALL c_f_pointer(opArg2%data_d,opDat2Deviceale_advect_volmass,(/opDat2Cardinality/))
  CALL c_f_pointer(opArg2%map_data_d,opMap2Deviceale_advect_volmass,(/opMap2Cardinality/))
  CALL c_f_pointer(opArg7%data_d,opDat7Deviceale_advect_volmass,(/opDat7Cardinality/))
  CALL c_f_pointer(opArg7%map_data_d,opMap7Deviceale_advect_volmass,(/opMap7Cardinality/))
  CALL c_f_pointer(opArg1%data_d,opDat1Deviceale_advect_volmass,(/opDat1Cardinality/))
  CALL c_f_pointer(opArg6%data_d,opDat6Deviceale_advect_volmass,(/opDat6Cardinality/))
  CALL c_f_pointer(opArg11%data_d,opDat11Deviceale_advect_volmass,(/opDat11Cardinality/))
  CALL c_f_pointer(opArg12%data_d,opDat12Deviceale_advect_volmass,(/opDat12Cardinality/))
  CALL c_f_pointer(opArg13%data_d,opDat13Deviceale_advect_volmass,(/opDat13Cardinality/))
  CALL c_f_pointer(opArg14%data_d,opDat14Deviceale_advect_volmass,(/opDat14Cardinality/))
  CALL c_f_pointer(opArg15%data_d,opDat15Deviceale_advect_volmass,(/opDat15Cardinality/))
  CALL c_f_pointer(opArg16%data_d,opDat16Deviceale_advect_volmass,(/opDat16Cardinality/))
  CALL c_f_pointer(opArg17%data,opDat17Host)

  CALL c_f_pointer(planRet_ale_advect_volmass,actualPlan_ale_advect_volmass)
  CALL c_f_pointer(actualPlan_ale_advect_volmass%ncolblk,ncolblk,(/set%setPtr%size/))
  pblkMapSize = actualPlan_ale_advect_volmass%nblocks
  CALL c_f_pointer(actualPlan_ale_advect_volmass%blkmap_d,pblkMap,(/pblkMapSize/))
  poffsetSize = actualPlan_ale_advect_volmass%nblocks
  CALL c_f_pointer(actualPlan_ale_advect_volmass%offset_d,poffset,(/poffsetSize/))
  pnelemsSize = actualPlan_ale_advect_volmass%nblocks
  CALL c_f_pointer(actualPlan_ale_advect_volmass%nelems_d,pnelems,(/pnelemsSize/))
  pnthrcolSize = actualPlan_ale_advect_volmass%nblocks
  CALL c_f_pointer(actualPlan_ale_advect_volmass%nthrcol,pnthrcol,(/pnthrcolSize/))
  pthrcolSize = set%setPtr%size
  CALL c_f_pointer(actualPlan_ale_advect_volmass%thrcol,pthrcol,(/pthrcolSize/))
  CALL c_f_pointer(actualPlan_ale_advect_volmass%nsharedCol,nsharedCol,(/actualPlan_ale_advect_volmass%ncolors_core/))
  CALL c_f_pointer(actualPlan_ale_advect_volmass%nindirect,pnindirect,(/actualPlan_ale_advect_volmass%ninds_staged/))
  CALL c_f_pointer(actualPlan_ale_advect_volmass%ind_maps,ind_maps,(/actualPlan_ale_advect_volmass%ninds_staged/))
  CALL c_f_pointer(actualPlan_ale_advect_volmass%maps,mappingArray,(/numberOfOpDats/))
  CALL c_f_pointer(actualPlan_ale_advect_volmass%ind_sizes,ind_sizes,(/actualPlan_ale_advect_volmass%nblocks * actualPlan_ale_advect_volmass%ninds_staged/))
  CALL c_f_pointer(actualPlan_ale_advect_volmass%ind_offs,ind_offs,(/actualPlan_ale_advect_volmass%nblocks * actualPlan_ale_advect_volmass%ninds_staged/))




  blockOffset = 0

  threadsPerBlock = getBlockSize(userSubroutine//C_NULL_CHAR,set%setPtr%size)
  DO i2 = 0, actualPlan_ale_advect_volmass%ncolors - 1, 1
    IF (i2 .EQ. actualPlan_ale_advect_volmass%ncolors_core) THEN
      CALL op_mpi_wait_all_cuda(numberOfOpDats,opArgArray)
    END IF

    blocksPerGrid = ncolblk(i2 + 1)
    dynamicSharedMemorySize = MAX(reductionSize(opArgArray,numberOfOpDats) * threadsPerBlock, nsharedCol(1+i2))

    CALL op_cuda_ale_advect_volmass <<<blocksPerGrid,threadsPerBlock,dynamicSharedMemorySize>>> (&
    & opDat2Deviceale_advect_volmass, &
    & opDat7Deviceale_advect_volmass, &
    & opMap2Deviceale_advect_volmass, &
    & opDat1Deviceale_advect_volmass, &
    & opDat6Deviceale_advect_volmass, &
    & opDat11Deviceale_advect_volmass, &
    & opDat12Deviceale_advect_volmass, &
    & opDat13Deviceale_advect_volmass, &
    & opDat14Deviceale_advect_volmass, &
    & opDat15Deviceale_advect_volmass, &
    & opDat16Deviceale_advect_volmass, &
    & opDat17Host, &
    & ind_sizes, &
    & ind_offs, &
    & pblkMap, &
    & poffset,pnelems,pnthrcol,pthrcol, &
    & set%setPtr%size+set%setPtr%exec_size, blockOffset)

    blockOffset = blockOffset + blocksPerGrid
  END DO


  IF ((n_upper .EQ. 0) .OR. (n_upper .EQ. set%setPtr%core_size)) THEN
    CALL op_mpi_wait_all_cuda(numberOfOpDats,opArgArray)
  END IF


  CALL op_mpi_set_dirtybit_cuda(numberOfOpDats,opArgArray)

  istat = cudaDeviceSynchronize()
  call op_timers_core(endTime)

  returnSetKernelTiming = setKernelTime(4 , userSubroutine//C_NULL_CHAR, &
  & endTime-startTime, actualPlan_ale_advect_volmass%transfer,actualPlan_ale_advect_volmass%transfer2, 1)
  calledTimes = calledTimes + 1
END SUBROUTINE

END MODULE
