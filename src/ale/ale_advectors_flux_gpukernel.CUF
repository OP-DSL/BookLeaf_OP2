    CALL op_cuda_ale_advectors_flux <<<blocksPerGrid,threadsPerBlock,dynamicSharedMemorySize>>> (&
    & getSetSizeFromOpArg(opArg1), &
    & opDat2Deviceale_advectors_flux, &
    & opDat7Deviceale_advectors_flux, &
    & opMap2Deviceale_advectors_flux, &
    & opDat1Deviceale_advectors_flux, &
    & opDat6Deviceale_advectors_flux, &
    & opDat11Deviceale_advectors_flux, &
    & opDat12Deviceale_advectors_flux, &
    & opDat13Deviceale_advectors_flux, &
    & opDat14Host, &
    & pblkMap, &
    & poffset,pnelems,pnthrcol,pthrcol, &
    & set%setPtr%size+set%setPtr%exec_size, blockOffset)

    blockOffset = blockOffset + blocksPerGrid
  END DO


  IF ((n_upper .EQ. 0) .OR. (n_upper .EQ. set%setPtr%core_size)) THEN
    CALL op_mpi_wait_all_cuda(numberOfOpDats,opArgArray)
  END IF


  CALL op_mpi_set_dirtybit_cuda(numberOfOpDats,opArgArray)

  istat = cudaDeviceSynchronize()
  call op_timers_core(endTime)

  returnSetKernelTiming = setKernelTime(10 , userSubroutine//C_NULL_CHAR, &
  & endTime-startTime, actualPlan_ale_advectors_flux%transfer,actualPlan_ale_advectors_flux%transfer2, 1)
  calledTimes = calledTimes + 1
END SUBROUTINE

END MODULE
