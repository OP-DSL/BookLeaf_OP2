  n_upper = op_mpi_halo_exchanges_cuda(set%setCPtr,numberOfOpDats,opArgArray)

  indirectionDescriptorArray(1) = -1
  indirectionDescriptorArray(2) = 0
  indirectionDescriptorArray(3) = 0
  indirectionDescriptorArray(4) = 0
  indirectionDescriptorArray(5) = 0
  indirectionDescriptorArray(6) = -1
  indirectionDescriptorArray(7) = 1
  indirectionDescriptorArray(8) = 1
  indirectionDescriptorArray(9) = 1
  indirectionDescriptorArray(10) = 1
  indirectionDescriptorArray(11) = -1
  indirectionDescriptorArray(12) = -1
  indirectionDescriptorArray(13) = -1
  indirectionDescriptorArray(14) = -1
  indirectionDescriptorArray(15) = -1

  numberOfIndirectOpDats = 2

  partitionSize = getPartitionSize(userSubroutine//C_NULL_CHAR,set%setPtr%size)

  planRet_ale_advectors_flux2 = FortranPlanCaller( &
  & userSubroutine//C_NULL_CHAR, &
  & set%setCPtr, &
  & partitionSize, &
  & numberOfOpDats, &
  & opArgArray, &
  & numberOfIndirectOpDats, &
  & indirectionDescriptorArray,2)

  opDat2Cardinality = opArg2%dim * getSetSizeFromOpArg(opArg2)
  opMap2Cardinality = set%setPtr%size * getMapDimFromOpArg(opArg2)
  opDat7Cardinality = opArg7%dim * getSetSizeFromOpArg(opArg7)
  opMap7Cardinality = set%setPtr%size * getMapDimFromOpArg(opArg7)
  opDat1Cardinality = opArg1%dim * getSetSizeFromOpArg(opArg1)
  opDat6Cardinality = opArg6%dim * getSetSizeFromOpArg(opArg6)
  opDat11Cardinality = opArg11%dim * getSetSizeFromOpArg(opArg11)
  opDat12Cardinality = opArg12%dim * getSetSizeFromOpArg(opArg12)
  opDat13Cardinality = opArg13%dim * getSetSizeFromOpArg(opArg13)
  opDat14Cardinality = opArg14%dim
  opDat15Cardinality = opArg15%dim


  CALL c_f_pointer(opArg2%data_d,opDat2Deviceale_advectors_flux2,(/opDat2Cardinality/))
  CALL c_f_pointer(opArg2%map_data_d,opMap2Deviceale_advectors_flux2,(/opMap2Cardinality/))
  CALL c_f_pointer(opArg7%data_d,opDat7Deviceale_advectors_flux2,(/opDat7Cardinality/))
  CALL c_f_pointer(opArg7%map_data_d,opMap7Deviceale_advectors_flux2,(/opMap7Cardinality/))
  CALL c_f_pointer(opArg1%data_d,opDat1Deviceale_advectors_flux2,(/opDat1Cardinality/))
  CALL c_f_pointer(opArg6%data_d,opDat6Deviceale_advectors_flux2,(/opDat6Cardinality/))
  CALL c_f_pointer(opArg11%data_d,opDat11Deviceale_advectors_flux2,(/opDat11Cardinality/))
  CALL c_f_pointer(opArg12%data_d,opDat12Deviceale_advectors_flux2,(/opDat12Cardinality/))
  CALL c_f_pointer(opArg13%data_d,opDat13Deviceale_advectors_flux2,(/opDat13Cardinality/))
  CALL c_f_pointer(opArg14%data,opDat14Host)
  CALL c_f_pointer(opArg15%data,opDat15Host)

  CALL c_f_pointer(planRet_ale_advectors_flux2,actualPlan_ale_advectors_flux2)
  CALL c_f_pointer(actualPlan_ale_advectors_flux2%ncolblk,ncolblk,(/set%setPtr%size/))
  pblkMapSize = actualPlan_ale_advectors_flux2%nblocks
  CALL c_f_pointer(actualPlan_ale_advectors_flux2%blkmap_d,pblkMap,(/pblkMapSize/))
  poffsetSize = actualPlan_ale_advectors_flux2%nblocks
  CALL c_f_pointer(actualPlan_ale_advectors_flux2%offset_d,poffset,(/poffsetSize/))
  pnelemsSize = actualPlan_ale_advectors_flux2%nblocks
  CALL c_f_pointer(actualPlan_ale_advectors_flux2%nelems_d,pnelems,(/pnelemsSize/))
  pnthrcolSize = actualPlan_ale_advectors_flux2%nblocks
  CALL c_f_pointer(actualPlan_ale_advectors_flux2%nthrcol,pnthrcol,(/pnthrcolSize/))
  pthrcolSize = set%setPtr%size
  CALL c_f_pointer(actualPlan_ale_advectors_flux2%thrcol,pthrcol,(/pthrcolSize/))


  blockOffset = 0

  threadsPerBlock = getBlockSize(userSubroutine//C_NULL_CHAR,set%setPtr%size)
  DO i2 = 0, actualPlan_ale_advectors_flux2%ncolors - 1, 1
    IF (i2 .EQ. actualPlan_ale_advectors_flux2%ncolors_core) THEN
      CALL op_mpi_wait_all_cuda(numberOfOpDats,opArgArray)
    END IF

    blocksPerGrid = ncolblk(i2 + 1)
    dynamicSharedMemorySize = reductionSize(opArgArray,numberOfOpDats) * threadsPerBlock

    CALL op_cuda_ale_advectors_flux2 <<<blocksPerGrid,threadsPerBlock,dynamicSharedMemorySize>>> (&
    & opDat2Deviceale_advectors_flux2, &
    & opDat7Deviceale_advectors_flux2, &
    & opMap2Deviceale_advectors_flux2, &
    & opDat1Deviceale_advectors_flux2, &
    & opDat6Deviceale_advectors_flux2, &
    & opDat11Deviceale_advectors_flux2, &
    & opDat12Deviceale_advectors_flux2, &
    & opDat13Deviceale_advectors_flux2, &
    & opDat14Host, &
    & opDat15Host, &
    & pblkMap, &
    & poffset,pnelems,pnthrcol,pthrcol, &
    & set%setPtr%size+set%setPtr%exec_size, blockOffset)

    blockOffset = blockOffset + blocksPerGrid
  END DO


  IF ((n_upper .EQ. 0) .OR. (n_upper .EQ. set%setPtr%core_size)) THEN
    CALL op_mpi_wait_all_cuda(numberOfOpDats,opArgArray)
  END IF


  CALL op_mpi_set_dirtybit_cuda(numberOfOpDats,opArgArray)

  istat = cudaDeviceSynchronize()
  call op_timers_core(endTime)

  returnSetKernelTiming = setKernelTime(11 , userSubroutine//C_NULL_CHAR, &
  & endTime-startTime, actualPlan_ale_advectors_flux2%transfer,actualPlan_ale_advectors_flux2%transfer2, 1)
  calledTimes = calledTimes + 1
END SUBROUTINE

END MODULE
