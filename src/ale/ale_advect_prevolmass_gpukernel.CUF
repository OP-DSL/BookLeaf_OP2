  CALL c_f_pointer(opArg5%data_d,opDat5Deviceale_advect_prevolmass,(/opDat5Cardinality/))
  CALL c_f_pointer(opArg5%map_data_d,opMap5Deviceale_advect_prevolmass,(/opMap5Cardinality/))
  CALL c_f_pointer(opArg6%data_d,opDat6Deviceale_advect_prevolmass,(/opDat6Cardinality/))
  CALL c_f_pointer(opArg6%map_data_d,opMap6Deviceale_advect_prevolmass,(/opMap6Cardinality/))
  CALL c_f_pointer(opArg7%data_d,opDat7Deviceale_advect_prevolmass,(/opDat7Cardinality/))
