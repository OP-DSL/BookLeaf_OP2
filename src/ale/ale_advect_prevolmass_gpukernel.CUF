  CALL c_f_pointer(opArg4%data_d,opDat4Deviceale_advect_prevolmass,(/opDat4Cardinality/))

  CALL c_f_pointer(planRet_ale_advect_prevolmass,actualPlan_ale_advect_prevolmass)
  CALL c_f_pointer(actualPlan_ale_advect_prevolmass%ncolblk,ncolblk,(/set%setPtr%size/))
  pblkMapSize = actualPlan_ale_advect_prevolmass%nblocks
